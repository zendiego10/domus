  <diagram name="Página-1" id="wfLei7fYYBs8kcGD-eTS">
    <mxGraphModel dx="2438" dy="1281" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n%% ===== PERSONAS Y SISTEMAS EXTERNOS =====\nPadre[\&quot;Padre/Madre&lt;br/&gt;Usuario del sistema\&quot;]\nHijo[\&quot;Hijo&lt;br/&gt;Usuario del sistema\&quot;]\nWeb[\&quot;Aplicación web&lt;br/&gt;React + Vite\&quot;]\nDB[\&quot;Base de datos&lt;br/&gt;Supabase PostgreSQL\&quot;]\nBrevo[\&quot;Brevo&lt;br/&gt;Servicio externo de correo\&quot;]\n\nPadre --&gt;|Usa la aplicación web · HTTPS| Web\nHijo --&gt;|Usa la aplicación web · HTTPS| Web\n\n%% ===== BACKEND =====\nsubgraph Backend[\&quot;API REST (Backend)&lt;br/&gt;Node.js + Express\&quot;]\ndirection LR\n\n    %% --- API ---\n    subgraph API[\&quot;api&lt;br/&gt;Controladores, middleware y aplicación Express\&quot;]\n    direction TB\n        AppExpress[\&quot;App Express&lt;br/&gt;Configura rutas y middleware\&quot;]\n        AuthMiddleware[\&quot;AuthMiddleware&lt;br/&gt;Verifica token JWT, rol y familia\&quot;]\n        ProgressController[\&quot;ProgressController&lt;br/&gt;GET /api/children/:id/progress\&quot;]\n        TaskController[\&quot;TaskController&lt;br/&gt;Endpoints de tareas\&quot;]\n        RewardController[\&quot;RewardController&lt;br/&gt;Endpoints de solicitudes y canjes\&quot;]\n    end\n\n    %% --- DOMAIN ---\n    subgraph DOMAIN[\&quot;domain&lt;br/&gt;Lógica de negocio y reglas del sistema\&quot;]\n    direction TB\n        GamificationService[\&quot;GamificationService&lt;br/&gt;Puntos, nivel, racha e insignias\&quot;]\n        TaskStateMachine[\&quot;TaskStateMachine&lt;br/&gt;Transiciones válidas de tareas\&quot;]\n        TaskService[\&quot;TaskService&lt;br/&gt;Casos de uso de tareas\&quot;]\n        RewardService[\&quot;RewardService&lt;br/&gt;Solicitudes y aprobación de canjes\&quot;]\n        NotificationService[\&quot;NotificationService&lt;br/&gt;Registrar notificaciones\&quot;]\n    end\n\n    %% --- DATA ---\n    subgraph DATA[\&quot;data&lt;br/&gt;Acceso a datos y repositorios\&quot;]\n    direction TB\n        ChildRepository[\&quot;ChildRepository&lt;br/&gt;Lee y escribe hijos\&quot;]\n        TaskRepository[\&quot;TaskRepository&lt;br/&gt;Lee y escribe tareas\&quot;]\n        ActivityLogRepository[\&quot;ActivityLogRepository&lt;br/&gt;Historial de actividad\&quot;]\n        RewardRepository[\&quot;RewardRepository&lt;br/&gt;Canjes y recompensas\&quot;]\n        supabaseAdmin[\&quot;supabaseAdmin&lt;br/&gt;Cliente de Supabase con clave de servicio\&quot;]\n        complete_task[\&quot;complete_task()&lt;br/&gt;Función transaccional\&quot;]\n    end\nend\n\n%% ===== RELACIONES PRINCIPALES =====\nWeb --&gt;|Consulta progreso · JSON/HTTPS| ProgressController\n\nAppExpress -. registra .-&gt; AuthMiddleware\nAppExpress -. registra .-&gt; ProgressController\nAppExpress -. registra .-&gt; TaskController\nAppExpress -. registra .-&gt; RewardController\n\nAuthMiddleware -. protege .-&gt; ProgressController\nAuthMiddleware -. protege .-&gt; TaskController\nAuthMiddleware -. protege .-&gt; RewardController\n\nProgressController --&gt; GamificationService\n\nTaskController --&gt; TaskService\nRewardController --&gt; RewardService\n\nTaskService --&gt; TaskStateMachine\nTaskService --&gt; TaskRepository\nTaskService --&gt; NotificationService\n\nRewardService --&gt; RewardRepository\nRewardService --&gt; GamificationService\n\nGamificationService --&gt; ChildRepository\nGamificationService --&gt; TaskRepository\n\nNotificationService -. usa repositorios .-&gt; ChildRepository\nNotificationService -. usa repositorios .-&gt; TaskRepository\nNotificationService -. registra actividad .-&gt; ActivityLogRepository\n\nChildRepository --&gt; supabaseAdmin\nTaskRepository --&gt; supabaseAdmin\nActivityLogRepository --&gt; supabaseAdmin\nRewardRepository --&gt; supabaseAdmin\n\nTaskRepository -. llama función .-&gt; complete_task\n\nsupabaseAdmin --&gt;|acceso a datos| DB\ncomplete_task --&gt;|transacción| DB\n\nNotificationService -. puede integrarse .-&gt; Brevo\n\n%% ===== ESTILOS =====\nclassDef actor fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B1B1B;\nclassDef web fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#1B1B1B;\nclassDef external fill:#F3F4F6,stroke:#6B7280,stroke-width:2px,color:#1B1B1B;\n\nclassDef implemented fill:#DCEEFF,stroke:#1565C0,stroke-width:2px,color:#0F172A;\nclassDef implementedDomain fill:#E6F7E8,stroke:#2E7D32,stroke-width:2px,color:#0F172A;\nclassDef implementedData fill:#E8F1FF,stroke:#1D4ED8,stroke-width:2px,color:#0F172A;\nclassDef implementedSQL fill:#DFF6E3,stroke:#15803D,stroke-width:2px,color:#0F172A;\n\nclassDef planned fill:#F8F1FF,stroke:#8B5CF6,stroke-width:2px,stroke-dasharray: 6 4,color:#0F172A;\nclassDef plannedDomain fill:#FFF7DB,stroke:#D97706,stroke-width:2px,stroke-dasharray: 6 4,color:#0F172A;\nclassDef plannedData fill:#F5F3FF,stroke:#A855F7,stroke-width:2px,stroke-dasharray: 6 4,color:#0F172A;\n\nclass Padre,Hijo actor;\nclass Web web;\nclass DB,Brevo external;\n\n%% Semana 13 (color fuerte)\nclass AppExpress,ProgressController implemented;\nclass GamificationService,TaskStateMachine implementedDomain;\nclass ChildRepository,TaskRepository,supabaseAdmin implementedData;\nclass complete_task implementedSQL;\n\n%% Semana 15 (claro/punteado)\nclass AuthMiddleware,TaskController,RewardController planned;\nclass TaskService,RewardService,NotificationService plannedDomain;\nclass ActivityLogRepository,RewardRepository plannedData;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="hAWOo5m-7ANWkLjpHmyX-1">
